{
  "description": "Agent OS guard: deny catastrophic or secret-leaking actions, ask before destructive or outward-facing ones.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
